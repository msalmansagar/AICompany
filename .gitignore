# Maqsad AI — repository-wide ignore rules.
# Verified at creation: none of these patterns matched a tracked file, so this
# ignores only build output and local artifacts — it untracks nothing.

# ---- Dependencies ----
node_modules/

# ---- TypeScript / build output ----
*.tsbuildinfo
dist/
build/
out/

# ---- Vite ----
.vite/

# ---- Next.js ----
.next/
next-env.d.ts

# ---- Turborepo ----
.turbo/

# ---- Test coverage ----
coverage/

# ---- .NET (CRM plugins, EDP runtime) ----
bin/
obj/

# ---- Local environment (never commit secrets) ----
.env
.env.*
!.env.example
!.env.*.example

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db

# Session logs — appended by .claude/hooks (session-end.js), not source.
**/.claude/sessions/log.md
.claude/sessions/log.md

# Plugin strong-name key — private key, escrowed in the team secret store, never committed.
*.snk

# Scratch space for the ribbon solution export/import round trip.
projects/report-engine/.ribbon-build/
