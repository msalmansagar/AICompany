<Project Sdk="Microsoft.NET.Sdk">

  <!-- One self-contained plugin assembly (domain + data + plugin) referencing only the Xrm SDK,
       so no merge step is needed. Dataverse online rejects plugin assemblies above 4.7.1. -->
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Qdb.SurveyEngine</RootNamespace>
    <AssemblyName>Qdb.SurveyEngine</AssemblyName>
    <Version>1.0.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SignAssembly>true</SignAssembly>
    <!-- The company key shared with Qdb.FormEngine; Dataverse requires signed plugin assemblies. -->
    <AssemblyOriginatorKeyFile>..\..\..\dynamic-form-engine\crm-plugins\Qdb.FormEngine\Qdb.FormEngine.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.49" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

</Project>
