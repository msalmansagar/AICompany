# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# ── Dev proxy (Vite) ──────────────────────────────────────────────────────────
# App registration used by the local dev server to proxy requests to Dataverse.
# This principal needs READ access to qdb_* entities only.
CRM_ORG_URL=https://<your-org>.crm4.dynamics.com
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<dev-proxy-app-registration-client-id>
AZURE_CLIENT_SECRET=<dev-proxy-client-secret>

# ── Deploy script (deploy-cloud.js) ──────────────────────────────────────────
# SEPARATE app registration used only for web resource deployment.
# Must be different from the dev-proxy principal (C-04 audit condition).
# This principal needs: Web Resource (create/update) + PublishXml privilege only.
AZURE_DEPLOY_TENANT_ID=<your-tenant-id>
AZURE_DEPLOY_CLIENT_ID=<deploy-app-registration-client-id>
AZURE_DEPLOY_CLIENT_SECRET=<deploy-client-secret>

# WR_NAME=qdb_/workflow-designer/workflow-designer.htm   # optional override
