{
  "name": "crm-workflow-designer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/rename-output.mjs",
    "preview": "vite preview",
    "migrate": "npx ts-node scripts/migrate-workflow-schema.ts",
    "seed": "npx ts-node scripts/seed-workflow-demo.ts",
    "package": "npm run build && node scripts/packageSolution.js",
    "package:version": "npm run build && node scripts/packageSolution.js --version",
    "deploy:cloud": "node scripts/deploy-cloud.js",
    "deploy:cloud:build": "npm run build && node scripts/deploy-cloud.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fluentui/react-components": "^9.56.0",
    "@fluentui/react-icons": "^2.0.264",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.3.6",
    "elkjs": "^0.11.1",
    "html-to-image": "^1.11.11",
    "immer": "^10.1.1",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-querybuilder": "^7.5.0",
    "zod": "^3.24.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
