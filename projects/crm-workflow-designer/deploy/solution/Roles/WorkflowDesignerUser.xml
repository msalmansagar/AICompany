<?xml version="1.0" encoding="utf-8"?>
<!--
  WorkflowDesignerUser.xml — security role for CRM Visual Workflow Designer

  Grants Basic (user-owned) CRUD on the four workflow entities.
  Assign this role to any user who needs to create or edit workflow designs.

  depth="Basic" = user can operate on records they own.
  Upgrade to "Local" (business unit) or "Deep" (child BUs) as access
  requirements evolve — that change can be made post-deployment.

  privilegeid values are intentionally blank: CRM resolves the GUID from
  the privilege name at import time. Do not fabricate GUIDs here.
-->
<Roles>
  <Role name="Workflow Designer User"
        id="{B2C3D4E5-F6A7-8901-BCDE-F12345678901}"
        ismanaged="0"
        introducedversion="1.0.0.0">
    <RolePrivileges>

      <!-- qdb_work_item_record_type (Process) -->
      <RolePrivilege name="prvCreateqdb_work_item_record_type" privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_work_item_record_type"   privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_work_item_record_type"  privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_work_item_record_type" privilegeid="" depth="Basic"/>

      <!-- qdb_work_item_steps (Steps) -->
      <RolePrivilege name="prvCreateqdb_work_item_steps" privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_work_item_steps"   privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_work_item_steps"  privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_work_item_steps" privilegeid="" depth="Basic"/>

      <!-- qdb_outcome (Outcomes) -->
      <RolePrivilege name="prvCreateqdb_outcome" privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_outcome"   privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_outcome"  privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_outcome" privilegeid="" depth="Basic"/>

      <!-- qdb_outcomeworktasks (Routes) -->
      <RolePrivilege name="prvCreateqdb_outcomeworktasks" privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_outcomeworktasks"   privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_outcomeworktasks"  privilegeid="" depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_outcomeworktasks" privilegeid="" depth="Basic"/>

    </RolePrivileges>
  </Role>
</Roles>
