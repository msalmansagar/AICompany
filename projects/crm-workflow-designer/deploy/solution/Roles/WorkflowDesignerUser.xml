<?xml version="1.0" encoding="utf-8"?>
<!--
  WorkflowDesignerUser.xml — security role for CRM Visual Workflow Designer

  Grants Basic (user-owned) CRUD on the four workflow entities.
  Assign this role to any user who needs to create or edit workflow designs.

  depth="Basic" = user can operate on records they own.
  Upgrade to "Local" (business unit) or "Deep" (child BUs) as access
  requirements evolve — that change can be made post-deployment.

  privilegeid attribute is intentionally omitted: CRM resolves the privilege
  GUID from the privilege name at import time. An empty string causes a
  NullReferenceException in the CRM solution importer.
-->
<Roles>
  <Role name="Workflow Designer User"
        id="{B2C3D4E5-F6A7-8901-BCDE-F12345678901}"
        ismanaged="0"
        introducedversion="1.0.0.0">
    <RolePrivileges>

      <!-- qdb_work_item_record_type (Process) -->
      <RolePrivilege name="prvCreateqdb_work_item_record_type" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_work_item_record_type"   depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_work_item_record_type"  depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_work_item_record_type" depth="Basic"/>

      <!-- qdb_work_item_steps (Steps) -->
      <RolePrivilege name="prvCreateqdb_work_item_steps" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_work_item_steps"   depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_work_item_steps"  depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_work_item_steps" depth="Basic"/>

      <!-- qdb_outcome (Outcomes) -->
      <RolePrivilege name="prvCreateqdb_outcome" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_outcome"   depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_outcome"  depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_outcome" depth="Basic"/>

      <!-- qdb_outcomeworktasks (Routes) -->
      <RolePrivilege name="prvCreateqdb_outcomeworktasks" depth="Basic"/>
      <RolePrivilege name="prvReadqdb_outcomeworktasks"   depth="Basic"/>
      <RolePrivilege name="prvWriteqdb_outcomeworktasks"  depth="Basic"/>
      <RolePrivilege name="prvDeleteqdb_outcomeworktasks" depth="Basic"/>

    </RolePrivileges>
  </Role>
</Roles>
