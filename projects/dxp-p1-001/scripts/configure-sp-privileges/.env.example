# Dataverse environment — same org as provision-schema
DATAVERSE_ORG_URL=https://your-org.crm4.dynamics.com
DATAVERSE_TENANT_ID=your-azure-tenant-id

# Provisioning SP credentials (used to authenticate this script — must have
# Dataverse System Administrator role at run time to create/assign roles)
DATAVERSE_CLIENT_ID=provisioning-sp-azure-client-id
DATAVERSE_CLIENT_SECRET=provisioning-sp-secret

# Runtime SP — the Azure AD app whose system user will receive the minimum-privilege role
RUNTIME_SP_CLIENT_ID=runtime-sp-azure-client-id

# Set to true to preview what the script would do without writing to Dataverse
DRY_RUN=false

# debug | info | warn | error
LOG_LEVEL=info
