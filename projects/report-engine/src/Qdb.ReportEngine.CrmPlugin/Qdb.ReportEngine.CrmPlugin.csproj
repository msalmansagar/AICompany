<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dynamics 365 / Dataverse plugin assembly. Targets .NET Framework 4.6.2 (the plugin sandbox
    runtime for both on-prem 9.x and Dataverse cloud). Builds cross-platform via the reference-
    assemblies package, so no full framework install is required for `dotnet build`.

    Strong-naming is ON because on-prem registration requires a signed assembly, and signing both
    targets keeps one assembly identity everywhere. Generate the key once with
    `sn -k Qdb.ReportEngine.CrmPlugin.snk`.

    The key is deliberately NOT in source control (see .gitignore). It must be escrowed in the
    team's secret store: the public key token forms part of the assembly identity Dataverse
    registers, so building with a different key produces an assembly the platform treats as a
    separate one — the existing registration could no longer be updated in place.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Qdb.ReportEngine.CrmPlugin</AssemblyName>
    <RootNamespace>Qdb.ReportEngine.CrmPlugin</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Qdb.ReportEngine.CrmPlugin.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- System.Net.Http ships with the framework but is not auto-referenced by the SDK for net462. -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qdb.ReportEngine.CrmPlugin.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
