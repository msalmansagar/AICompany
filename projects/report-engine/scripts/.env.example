# Report Engine — deployment script settings.
# Copy to .env (which is gitignored) and fill in. Every script takes the path as its first argument:
#   node scripts/verify-schema.mjs ./scripts/.env
#
# The organisation. Trailing slash optional.
DV_DATAVERSE_URL=https://org5869857f.crm4.dynamics.com

# How to authenticate. Default is entra.
#   entra    Microsoft Entra client credentials.        Dataverse online.
#   adfs     OAuth against an ADFS server.              On-premises, internet-facing (IFD).
#   windows  Negotiate/NTLM as the signed-in account.   On-premises, internal.
DV_AUTH_MODE=entra

# --- DV_AUTH_MODE=entra ---
DV_TENANT_ID=
DV_CLIENT_ID=
DV_CLIENT_SECRET=

# --- DV_AUTH_MODE=adfs ---
# Give either the token endpoint outright, or the ADFS root and /adfs/oauth2/token is appended.
# ADFS predates the v2 endpoint and is sent `resource`, not `scope` — a v2-shaped request returns a
# token the organisation then rejects, which looks like 401 on every call rather than a bad token.
#DV_ADFS_URL=https://sts.yourbank.local
#DV_ADFS_TOKEN_URL=https://sts.yourbank.local/adfs/oauth2/token
#DV_CLIENT_ID=<the client id registered in ADFS for these scripts>
#DV_CLIENT_SECRET=<omit if using the username/password grant below>
#DV_USERNAME=DOMAIN\svc-reportengine
#DV_PASSWORD=

# --- DV_AUTH_MODE=windows ---
# Nothing to configure: requests are made by curl.exe as whoever is running the script, so run it
# as an account with the System Administrator role. curl.exe ships with Windows 10, 11 and
# Server 2019+; `curl.exe --version` confirms it.

# --- Optional, all modes ---
# The Web API version is normally read off the organisation (RetrieveVersion on v9.0). Set this only
# to pin it: Dataverse online serves 9.2, the last on-premises release serves 9.1.
#DV_API_VERSION=9.1
