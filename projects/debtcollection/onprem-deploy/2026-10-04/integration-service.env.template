# DCP Integration Service — on-prem settings TEMPLATE (names only; never commit values).
# Hosted by QDB on infrastructure that reaches BOTH HL CRM and BFD CRM / QDB1.
# Validated at startup by apps/api/src/config.ts — a missing or malformed value stops the service.

PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# HL CRM (Housing Loan) — mandatory
DV_DATAVERSE_URL=https://<hl-crm-host>/<HousingLoan-org>
DV_API_VERSION=9.1
DV_TENANT_ID=<adfs-or-tenant-identifier>
DV_CLIENT_ID=<registered-client-id>
DV_CLIENT_SECRET=<from-secret-store>
DV_SCOPE=<hl-crm-resource-scope>

# BFD CRM / QDB1 — Case Management and Legal live here for BOTH books
FEATURE_BFD=true
DV_BFD_DATAVERSE_URL=https://<bfd-crm-host>/<QDB1-org>
DV_BFD_API_VERSION=9.1
DV_BFD_TENANT_ID=<adfs-or-tenant-identifier>
DV_BFD_CLIENT_ID=<registered-client-id>
DV_BFD_CLIENT_SECRET=<from-secret-store>
DV_BFD_SCOPE=<bfd-crm-resource-scope>

# Existing BFD "Non Customer" account named as the customer of every HL complaint.
# Candidate from QDB1's "Updating Non Customer" business rule — CONFIRM IN QDB1 before use.
CASE_MANAGEMENT_NON_CUSTOMER_ACCOUNT_ID=<guid-of-active-Non-Customer-account-in-QDB1>

# User-token validation (on-prem: AD FS)
AUTH_PROVIDER=adfs
AUTH_ISSUER_URL=https://<adfs-host>/adfs
AUTH_AUDIENCE=<relying-party-identifier>
