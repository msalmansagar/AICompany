# DCP provisioning / registration / smoke tooling — required environment variables.
# Copy to .env and fill in values. Never commit .env to git.
#
# On-premises (D365 CE 9.1) and Dataverse cloud are EQUAL deployment targets. Both the Web API
# version and the authentication mechanism are configuration, so the same tooling reaches either.

# --- organisation -----------------------------------------------------------
DV_DATAVERSE_URL=
# "9.1" on Dynamics 365 CE 9.1 on-premises, "9.2" on Dataverse cloud. Required, no default:
# defaulting would let a deployment silently issue calls for the wrong platform.
DV_API_VERSION=

# --- credentials ------------------------------------------------------------
DV_CLIENT_ID=
DV_CLIENT_SECRET=

# --- platform authentication ------------------------------------------------
# entra   Microsoft Entra ID (Azure AD) client credentials   → Dataverse cloud   (needs DV_TENANT_ID)
# adfs    AD FS 2019 / standards OIDC token endpoint         → on-premises       (needs DV_AUTH_AUTHORITY)
# ifd     D365 CE on-premises IFD via an OAuth token endpoint → on-premises       (needs DV_AUTH_AUTHORITY)
# windows Windows-integrated auth — NOT supported by this tooling; use the Plugin Registration
#         Tool and solution import instead (see docs/DeploymentGuide.md)
DV_AUTH_MODE=entra

# required when DV_AUTH_MODE=entra
DV_TENANT_ID=

# required when DV_AUTH_MODE=adfs or ifd, e.g. https://adfs.qdb.local/adfs
# the tooling appends /oauth2/token
DV_AUTH_AUTHORITY=
