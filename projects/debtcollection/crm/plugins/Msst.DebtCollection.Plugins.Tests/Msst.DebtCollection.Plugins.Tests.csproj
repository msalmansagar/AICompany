<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>Msst.DebtCollection.Plugins.Tests</AssemblyName>
    <RootNamespace>Msst.DebtCollection.Plugins.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.7.1 reference assemblies via NuGet (GOT-005) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net471" Version="1.0.3" PrivateAssets="All" />

    <!-- Test runner -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- SDK (compile-only in main project; tests need it at runtime for mocking) -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.51" />

    <!-- Mocking (dependencies.md §8 — Moq, MIT, no FakeXrmEasy) -->
    <PackageReference Include="Moq" Version="4.20.70" />

    <!-- JSON for audit-payload assertions -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msst.DebtCollection.Plugins\Msst.DebtCollection.Plugins.csproj" />
  </ItemGroup>

</Project>
