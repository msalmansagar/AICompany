{
  "code": "DCP-RPT-002",
  "name": "DCP — Open cases by source system",
  "description": "Open collection cases grouped by the CRM of record (Housing Loan / BFD), with current arrears and loan balance summed. Grain: CASE. Source: qdb_collectioncase. Narrowed by bucket, strategy and case status when supplied. DCP catalogue DCP-RPT-002.",
  "version": 1,
  "mainEntity": "qdb_collectioncase",
  "category": "Management",
  "rowLimit": 5000,
  "grain": "CASE",
  "mode": "generated",
  "entity": { "logicalName": "qdb_collectioncase", "alias": "t" },
  "columns": [
    { "name": "Source system", "attribute": "qdb_organizationcode", "alias": "source", "dataType": "Integer", "aggregate": "None", "groupOrder": 1, "sortOrder": 1 },
    { "name": "Cases", "attribute": "qdb_collectioncaseid", "alias": "cases", "dataType": "Integer", "aggregate": "Count", "sortOrder": 2 },
    { "name": "Current arrears", "attribute": "qdb_currenttotalarrears", "alias": "arrears", "dataType": "Money", "aggregate": "Sum", "sortOrder": 3 },
    { "name": "Loan balance", "attribute": "qdb_currentloanbalance", "alias": "balance", "dataType": "Money", "aggregate": "Sum", "sortOrder": 4 }
  ],
  "filters": [
    { "name": "Open cases only", "field": "statecode", "operator": "Equals", "value": "0", "valueType": "Number" },
    { "name": "Bucket", "field": "qdb_currentarrearbucket", "operator": "Equals", "value": "Bucket", "runtimePrompt": true },
    { "name": "Strategy", "field": "qdb_strategyid", "operator": "Equals", "value": "Strategy", "runtimePrompt": true },
    { "name": "Case status", "field": "statuscode", "operator": "Equals", "value": "CaseStatus", "runtimePrompt": true }
  ],
  "parameters": [
    { "name": "Bucket", "label": "MIS bucket (option value)", "type": "Number", "required": false },
    { "name": "Strategy", "label": "Strategy (id)", "type": "Lookup", "required": false },
    { "name": "CaseStatus", "label": "Case status (status code)", "type": "Number", "required": false }
  ]
}
