{
  "code": "DCP-RPT-001",
  "name": "DCP — Open cases by MIS bucket",
  "description": "Open collection cases grouped by the MIS arrear bucket, with current arrears and loan balance summed. Grain: CASE (one case is one delinquent facility). Source: qdb_collectioncase, MIS-derived current position. Narrowed by source system (HL/BFD), strategy, case status and owner when supplied. DCP catalogue DCP-RPT-001.",
  "version": 3,
  "mainEntity": "qdb_collectioncase",
  "category": "Management",
  "rowLimit": 5000,
  "grain": "CASE",
  "mode": "generated",
  "entity": {
    "logicalName": "qdb_collectioncase",
    "alias": "t"
  },
  "columns": [
    {
      "name": "Bucket",
      "attribute": "qdb_currentarrearbucket",
      "alias": "bucket",
      "dataType": "Integer",
      "aggregate": "None",
      "groupOrder": 1,
      "sortOrder": 1
    },
    {
      "name": "Cases",
      "attribute": "qdb_collectioncaseid",
      "alias": "cases",
      "dataType": "Integer",
      "aggregate": "Count",
      "sortOrder": 2
    },
    {
      "name": "Current arrears",
      "attribute": "qdb_currenttotalarrears",
      "alias": "arrears",
      "dataType": "Money",
      "aggregate": "Sum",
      "sortOrder": 3
    },
    {
      "name": "Loan balance",
      "attribute": "qdb_currentloanbalance",
      "alias": "balance",
      "dataType": "Money",
      "aggregate": "Sum",
      "sortOrder": 4
    }
  ],
  "filters": [
    {
      "name": "Open cases only",
      "field": "statecode",
      "operator": "Equals",
      "value": "0",
      "valueType": "Number"
    },
    {
      "name": "Source system",
      "field": "qdb_facilitysourcesystem",
      "operator": "Equals",
      "value": "SourceSystem",
      "runtimePrompt": true
    },
    {
      "name": "Strategy",
      "field": "qdb_strategyid",
      "operator": "Equals",
      "value": "Strategy",
      "runtimePrompt": true
    },
    {
      "name": "Case status",
      "field": "statuscode",
      "operator": "Equals",
      "value": "CaseStatus",
      "runtimePrompt": true
    },
    {
      "name": "Owner",
      "field": "ownerid",
      "operator": "Equals",
      "value": "Owner",
      "runtimePrompt": true
    }
  ],
  "parameters": [
    {
      "name": "SourceSystem",
      "label": "Source system (HL or BFD)",
      "type": "Text",
      "required": false
    },
    {
      "name": "Strategy",
      "label": "Strategy (id)",
      "type": "Lookup",
      "required": false
    },
    {
      "name": "CaseStatus",
      "label": "Case status (status code)",
      "type": "Number",
      "required": false
    },
    {
      "name": "Owner",
      "label": "Owner (user id)",
      "type": "Lookup",
      "required": false
    }
  ]
}
