{
  "code": "DCP-RPT-011",
  "name": "DCP — Promises by recorded status",
  "description": "Collection activities carrying a promise-to-pay date, grouped by their recorded PTP status, with the promised amount summed. Each status is what an officer recorded, never a verified payment. Grain: PTP (one promise activity). Source: qdb_collectionactivity · qdb_ptpdate, qdb_ptpstatus, qdb_promisedamount. Both CRMs. Narrowed by owner and the promised-for window when supplied. DCP catalogue DCP-RPT-011.",
  "version": 1,
  "mainEntity": "qdb_collectionactivity",
  "category": "Operational",
  "rowLimit": 5000,
  "grain": "PTP",
  "mode": "generated",
  "entity": { "logicalName": "qdb_collectionactivity", "alias": "t" },
  "columns": [
    { "name": "Recorded status", "attribute": "qdb_ptpstatus", "alias": "status", "dataType": "Integer", "aggregate": "None", "groupOrder": 1, "sortOrder": 1 },
    { "name": "Promises", "attribute": "activityid", "alias": "promises", "dataType": "Integer", "aggregate": "Count", "sortOrder": 2 },
