    { "name": "Promised for on or after", "field": "qdb_ptpdate", "operator": "GreaterThan", "value": "DateFrom", "runtimePrompt": true },
    { "name": "Promised for before", "field": "qdb_ptpdate", "operator": "LessThan", "value": "DateTo", "runtimePrompt": true }
  ],
  "parameters": [
