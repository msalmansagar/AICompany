{
  "name": "@qdb/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript types and engines for Dynamic Form Engine",
  "main": "src/index.ts",
  "types": "src/server.ts",
  "scripts": {
    "check:types-sync": "node scripts/check-shared-type-sync.mjs",
    "build": "npm run check:types-sync && tsc",
    "watch": "tsc --watch",
    "typecheck": "npm run check:types-sync && tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "json-rules-engine": "^6.4.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "postcss": "^8"
  }
}
