# ─────────────────────────────────────────────────
# Dynamic Form Engine — Backend Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# ── Dataverse / CRM ───────────────────────────────
# Your Dataverse org URL (no trailing slash)
DATAVERSE_URL=https://org5869857f.crm4.dynamics.com

# ── Azure AD (service account for Dataverse access) ──
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-backend-app-client-id
AZURE_CLIENT_SECRET=your-backend-app-client-secret

# ── Azure AD (token validation for portal users) ──
# Must match the audience claim in tokens issued by the portal
AZURE_AD_AUDIENCE=api://your-backend-app-client-id

# ── Metadata Cache ─────────────────────────────────
# How long to cache form metadata (seconds). Default 300 (5 min).
METADATA_CACHE_TTL_SECONDS=300

# ── Local Development Mock ─────────────────────────
# Set to true to use MockCrmService instead of real Dataverse
# All CRM calls return sample Loan Application form data
MOCK_CRM=false

# ── Azure Blob Storage (optional — for file uploads to blob) ──
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=
STORAGE_CONTAINER_NAME=form-uploads

# ── CORS ───────────────────────────────────────────
# Exact origin(s) allowed to call this API. No wildcards in production.
CORS_ORIGIN=http://localhost:3000

# ── Logging ────────────────────────────────────────
LOG_LEVEL=info
