# Dataverse service-account credentials for the provisioning / seed scripts.
# Copy this file to `.env` (which is gitignored) and fill in the real secret.
#
# Run scripts with the env file loaded (Node 20.6+):
#   node --env-file=scripts/.env scripts/<script-name>.mjs
#
# Or export the variable in your shell before running:
#   export DV_CLIENT_SECRET="<the-rotated-secret>"

# Azure AD client secret for the Dataverse app registration.
# ROTATE in Azure AD — the previously committed value is compromised.
DV_CLIENT_SECRET=
