<?xml version="1.0" encoding="utf-8"?>
<!--
  Security Role: Form Designer User
  Publisher prefix: qdb
  Privilege depth: Basic (user-owned records only)

  Privilege depth encoding:
    0 = None
    1 = Basic  (user-owned)
    2 = Local  (business unit)
    3 = Deep   (business unit + child BUs)
    4 = Global (organisation-wide)

  WHY Basic depth: Form definitions are user-created assets. Each designer
  user should have full access to their own records. Organisation-wide access
  is granted via separate administrator roles, not this role.

  qdb_form_audit_log: Create+Read only — audit records are append-only per
  Article VI of the Technology Constitution. Write and Delete are intentionally
  withheld to preserve the integrity of the audit trail.

  qdb_form_version, qdb_theme: Delete withheld — versions and themes are
  retained for rollback and historical reference; accidental deletion would
  break form version history and theme consistency across forms.
-->
<Roles>
  <Role name="Form Designer User"
        id="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}"
        inheritsfromid="{00000000-0000-0000-0000-000000000000}"
        ismanaged="1"
        introducedversion="1.0.0.0">
    <RolePrivileges>

      <!-- qdb_form_definition: full CRUD -->
      <RolePrivilege name="prvCreateqdb_form_definition"  privilegeid=""  depth="Basic" />
      <RolePrivilege name="prvReadqdb_form_definition"    privilegeid=""  depth="Basic" />
      <RolePrivilege name="prvWriteqdb_form_definition"   privilegeid=""  depth="Basic" />
      <RolePrivilege name="prvDeleteqdb_form_definition"  privilegeid=""  depth="Basic" />

      <!-- qdb_form_tab: full CRUD -->
