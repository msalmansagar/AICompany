<?xml version="1.0" encoding="utf-8"?>
<!--
  Security Role: QDB CSS Allowlist Admin
  Engagement:    DFE-STYLE-001
  SC-05:         Restricts write on qdb_css_allowlist_config to this role.

  Purpose:
    Grants create/read/write/delete on qdb_css_allowlist_config only.
    Assign to form administrators who manage the CSS domain allowlist for the
    Dynamic Form Engine. Do NOT assign to general form designers.

  Deployment:
    This role is exported as part of the DynamicFormEngine managed solution.
    Import via PAC CLI: pac solution import --path ./dist/DynamicFormEngine.zip
    After import, assign role via Dynamics > Settings > Security > Users.

  Note:
    Privilege names follow the Dataverse convention: prv<Action><EntityLogicalName>
    with the entity logical name in camelCase (e.g. prvReadqdb_css_allowlist_config).
    The actual privilege GUIDs are resolved by Dataverse at import time from the
    entity registration in the same solution package — do not hardcode GUIDs here.
-->
<Role>
  <name>QDB CSS Allowlist Admin</name>
  <description>
    Grants Create, Read, Write, Delete, Append, and AppendTo on the
    qdb_css_allowlist_config entity. Assign to form administrators who manage
    the CSS domain allowlist for the Dynamic Form Engine (DFE-STYLE-001).
  </description>
  <RolePrivileges>
    <!--
      qdb_css_allowlist_config — Organization scope for create/read/write so the
      CSS Allowlist Admin can manage the global config record regardless of
      ownership. The 'global' record is created by the provisioning service
      principal, so a Basic (owner-only) write would lock the admin out of it
      (SEC-02). The entity is organisation-owned global configuration, not
      user-specific data, so Organization scope is appropriate. Delete stays
      Basic to discourage removing the global record (prefer qdb_is_active=false).
    -->
    <RolePrivilege name="prvCreateqdb_css_allowlist_config" level="Organization" />
    <RolePrivilege name="prvReadqdb_css_allowlist_config" level="Organization" />
    <RolePrivilege name="prvWriteqdb_css_allowlist_config" level="Organization" />
    <RolePrivilege name="prvDeleteqdb_css_allowlist_config" level="Basic" />
    <RolePrivilege name="prvAppendqdb_css_allowlist_config" level="Basic" />
    <RolePrivilege name="prvAppendToqdb_css_allowlist_config" level="Basic" />
  </RolePrivileges>
</Role>
