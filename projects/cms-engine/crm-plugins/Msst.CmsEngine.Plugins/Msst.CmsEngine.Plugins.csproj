<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dataverse online rejects plugin assemblies targeting above 4.7.1. -->
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>Msst.CmsEngine.Plugins</AssemblyName>
    <RootNamespace>Msst.CmsEngine.Plugins</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- A plugin assembly must be strong-name signed. The key is committed
         beside the project deliberately: the Report Engine's key was lost off
         the build machine, and without it that assembly can never be updated. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Msst.CmsEngine.snk</AssemblyOriginatorKeyFile>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>MSS Technologies</Company>
    <Product>MSS CMS Engine</Product>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The 4.7.1 targeting pack is not installed on the build machine; this
         package supplies the reference assemblies instead. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.49" />
  </ItemGroup>

</Project>
