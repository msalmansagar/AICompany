{
  "expo": {
    "name": "Portal",
    "slug": "portal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "portal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maqsad.portal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely access your portal account."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0078D4"
      },
      "package": "com.maqsad.portal",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0078D4",
          "sounds": []
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Portal to use Face ID to protect your session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/portal-mobile"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
