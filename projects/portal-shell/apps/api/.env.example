# Portal API — environment variables
# Copy to .env and fill in real values. Never commit .env to source control.

PORT=4001
NODE_ENV=development

DATAVERSE_URL=https://org5869857f.crm4.dynamics.com
TENANT_ID=d79e793c-f6de-4204-8508-7980a63df957
CLIENT_ID=08e80e93-0bab-45ef-8372-2e554fa9af9b
CLIENT_SECRET=<replace-with-client-secret>

# Must be at least 32 characters — shared with Next.js Auth.js configuration
JWT_SECRET=<replace-with-32-char-secret>

# Auth provider — one of: azure-ad-b2c | entra-external-id | custom
AUTH_PROVIDER=custom

# Required only when AUTH_PROVIDER=azure-ad-b2c
B2C_TENANT_NAME=
B2C_POLICY_NAME=

# Required only when AUTH_PROVIDER=entra-external-id
ENTRA_TENANT_ID=

LOG_LEVEL=info

# Seconds to cache portal config in memory (min 10)
CACHE_TTL_PORTAL_CONFIG=300

# Default notification poll interval in seconds (10–120)
NOTIFICATION_POLL_INTERVAL_DEFAULT=30

# Token lifetimes — reduce these during a security incident without a redeployment
# Access token: 60–86400 seconds (default 1 hour)
ACCESS_TOKEN_TTL_SECONDS=3600
# Refresh token: 3600–2592000 seconds (default 24 hours)
REFRESH_TOKEN_TTL_SECONDS=86400
# Password-reset token: 60–86400 seconds (default 15 minutes)
RESET_TOKEN_TTL_SECONDS=900
