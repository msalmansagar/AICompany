# =============================================================
# DFE-PORT-001/SCHEMA — Dataverse Schema Provisioning Script
# .env.example — All required variables documented; no values
# Copy to .env and fill in values before running.
# NEVER commit .env to source control.
# =============================================================

# Dataverse target environment
DATAVERSE_ORG_URL=https://yourorg.crm4.dynamics.com

# Service principal credentials (Azure App Registration)
DATAVERSE_CLIENT_ID=YOUR_SERVICE_PRINCIPAL_CLIENT_ID
DATAVERSE_CLIENT_SECRET=YOUR_SERVICE_PRINCIPAL_CLIENT_SECRET
DATAVERSE_TENANT_ID=YOUR_AZURE_AD_TENANT_ID

# Seed data
# This password is hashed at runtime using bcrypt cost factor 12.
# The plain-text is never stored or logged.
# Set a strong temporary password. Deactivate the user before promoting to production.
# Required when DRY_RUN=false. Optional when DRY_RUN=true.
SEED_TEST_USER_PASSWORD=YOUR_STRONG_TEMPORARY_PASSWORD_MIN_12_CHARS

# Script behaviour — optional, defaults shown
LOG_LEVEL=info
# Values: debug | info | warn | error
# Use "debug" to see every HTTP request URL and response status.

DRY_RUN=false
# Values: true | false
# When true: pre-flight checks run in full; all POST/PATCH/DELETE calls are
# skipped and logged as [DRY-RUN SKIP]. SEED_TEST_USER_PASSWORD is not required.
