<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EDP.RuleRuntime.Replay</RootNamespace>
    <!-- TC-3 replay harness (developer tool, not shipped). RuntimeProject is overridable so the
         SAME harness records goldens against the baseline engine:
         dotnet run -p:RuntimeProject=(baseline EDP.RuleRuntime.csproj), then the record command -->
    <RuntimeProject Condition="'$(RuntimeProject)' == ''">..\..\src\EDP.RuleRuntime\EDP.RuleRuntime.csproj</RuntimeProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RuntimeProject)" />
  </ItemGroup>

</Project>
