<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>

    <!-- P0 question 2: does an UNSIGNED assembly in a plug-in package load?
         The docs say signing is not required for package-hosted assemblies. This is the
         claim that, if true, removes the reason W0-1 exists. -->
    <SignAssembly>false</SignAssembly>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ProjectTypeGuids>{4C25E9B5-9FA6-436c-8E19-B395D2A65FAF};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
  </PropertyGroup>

  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.props')" />

  <PropertyGroup>
    <PackageId>qdb_EdpPackagingProbe</PackageId>
    <Version>$(FileVersion)</Version>
    <Authors>MSS Technologies</Authors>
    <Company>MSS Technologies</Company>
    <Description>Throwaway probe for ADR-18 P0. Reports which System.Text.Json the sandbox actually loaded and whether this assembly is signed. Delete after use.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Plugin" Version="1.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />

    <!-- P0 question 1: does the package bind the version it SHIPS, or does the sandbox's own
         copy win? 10.0.5 is deliberately the version EDP's csproj calls incompatible with
         net462 — a claim already disproved on target frameworks, and tested here at runtime.
         NOT PrivateAssets, so it travels inside the package. -->
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.targets')" />
</Project>
