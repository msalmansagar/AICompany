# EDP-BRE deploy credentials — service principal (client-credentials flow).
# Copy this to a local .env (kept out of git) and point EDP_ENV_PATH at it:
#   EDP_ENV_PATH=/abs/path/to/edp.env node deploy/bre-api-privileges.js
# If EDP_ENV_PATH is unset, the scripts fall back to a legacy default path.
# The deploy SP must have privileges to manage solution components in the target org.

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
DATAVERSE_URL=https://your-org.crm.dynamics.com
