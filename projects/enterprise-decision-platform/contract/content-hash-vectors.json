      "pcrm": "{\"schemaVersion\":\"1.1\",\"inputContract\":\"strict\",\"ruleId\":\"vec-b\",\"name\":\"Every input type\",\"targetEntity\":\"account\",\n\"inputs\":[\n {\"name\":\"note\",\"type\":\"Text\",\"required\":true,\"nullable\":false},\n {\"name\":\"amount\",\"type\":\"Decimal\",\"required\":true,\"nullable\":false},\n {\"name\":\"limit\",\"type\":\"Currency\"},\n {\"name\":\"count\",\"type\":\"WholeNumber\"},\n {\"name\":\"active\",\"type\":\"Boolean\"},\n {\"name\":\"status\",\"type\":\"Choice\"},\n {\"name\":\"segment\",\"type\":\"OptionSet\"},\n {\"name\":\"start\",\"type\":\"Date\"},\n {\"name\":\"at\",\"type\":\"DateTime\"},\n {\"name\":\"lines\",\"type\":\"Collection\"},\n {\"name\":\"region\",\"type\":\"Text\",\"binding\":\"address1_stateorprovince\"}],\n\"outputs\":[{\"name\":\"decision\",\"type\":\"Text\"}],\n\"logic\":{\"type\":\"conditionSet\",\"rules\":[{\"when\":{\"op\":\"and\",\"conditions\":[{\"field\":\"amount\",\"operator\":\"GreaterThanOrEqual\",\"value\":1000.00},{\"field\":\"active\",\"operator\":\"Equals\",\"value\":true}]},\"then\":{\"decision\":\"approve\"},\"reasonCodes\":[\"R1\"]}],\"otherwise\":{\"decision\":\"refer\"}}}",
      "canonical": "{\"inputContract\":\"strict\",\"inputs\":[{\"name\":\"note\",\"nullable\":false,\"required\":true,\"type\":\"Text\"},{\"name\":\"amount\",\"nullable\":false,\"required\":true,\"type\":\"Decimal\"},{\"name\":\"limit\",\"type\":\"Currency\"},{\"name\":\"count\",\"type\":\"WholeNumber\"},{\"name\":\"active\",\"type\":\"Boolean\"},{\"name\":\"status\",\"type\":\"Choice\"},{\"name\":\"segment\",\"type\":\"OptionSet\"},{\"name\":\"start\",\"type\":\"Date\"},{\"name\":\"at\",\"type\":\"DateTime\"},{\"name\":\"lines\",\"type\":\"Collection\"},{\"binding\":\"address1_stateorprovince\",\"name\":\"region\",\"type\":\"Text\"}],\"logic\":{\"otherwise\":{\"decision\":\"refer\"},\"rules\":[{\"reasonCodes\":[\"R1\"],\"then\":{\"decision\":\"approve\"},\"when\":{\"conditions\":[{\"field\":\"amount\",\"operator\":\"GreaterThanOrEqual\",\"value\":1000},{\"field\":\"active\",\"operator\":\"Equals\",\"value\":true}],\"op\":\"and\"}}],\"type\":\"conditionSet\"},\"outputs\":[{\"name\":\"decision\",\"type\":\"Text\"}],\"targetEntity\":\"account\"}",
